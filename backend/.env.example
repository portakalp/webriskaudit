# Settings of the WebRiskAudit API. They are read from the process
# environment; this file is not loaded automatically (export the values or
# pass them with "docker run --env-file"). Every value below is the default.

# Browser origins allowed to call the API (CORS), comma-separated.
# An empty value allows no browser origin.
ALLOWED_ORIGINS=http://localhost:3000,https://webriskaudit.com

# New scans allowed per client within the window. A client is an IPv4
# address or an IPv6 /64 network. Cached reports do not count, and a client
# may have one new scan running or waiting at a time. 0 turns these per-client
# limits off (local development only).
RATE_LIMIT_SCANS=10
RATE_LIMIT_WINDOW_SECONDS=600

# New scans allowed within the same window from all clients together, as a
# backstop against clients with many addresses. Further scans get 503. 0 turns
# it off.
GLOBAL_RATE_LIMIT_SCANS=600

# How long a domain's report is served from the in-memory cache. 0 caches
# nothing (concurrent requests for one domain still share one scan).
CACHE_TTL_SECONDS=600

# Scans running at the same time; further scans wait for a free slot. At most
# MAX_QUEUED_SCANS wait, each for QUEUE_TIMEOUT_SECONDS at most; beyond that
# the API answers 503 with Retry-After.
MAX_CONCURRENT_SCANS=4
MAX_QUEUED_SCANS=16
QUEUE_TIMEOUT_SECONDS=30

# Time budget of a whole scan and of each check. Checks still running when
# either runs out are reported as inconclusive ("timed out").
SCAN_DEADLINE_SECONDS=45
CHECK_TIMEOUT_SECONDS=30

# Recursive resolvers the scanner queries, as comma-separated IP addresses.
# Empty uses the system's resolvers (/etc/resolv.conf). Set public resolvers
# (for example 1.1.1.1,9.9.9.10) when the host's resolver also answers for
# private zones, as cloud VPC resolvers often do; otherwise the API reveals
# which internal names exist and their TXT records. Use unfiltered resolvers:
# Quad9's 9.9.9.9 blocks malicious domains, which then look nonexistent;
# 9.9.9.10 is its unfiltered service.
DNS_NAMESERVERS=

# Origin authentication, for running behind a proxy such as Cloudflare. The
# proxy adds an X-Origin-Auth header holding a shared secret to every request
# it forwards, and the API answers 403 to any request without one of these
# values, except GET / and GET /health (health checks). Comma-separated, so an
# old and a new secret can both be accepted during a rotation; each at least
# 32 visible ASCII characters (for example from "openssl rand -hex 32"). Empty
# turns origin authentication off, as for local runs and Docker Compose.
ORIGIN_AUTH_SECRETS=

# Header in which the proxy passes the client's address, the key of the rate
# limits: CF-Connecting-IP behind Cloudflare. Required with, and only allowed
# with, ORIGIN_AUTH_SECRETS, because without origin authentication anyone
# could set it. When empty, the client is the TCP peer; X-Forwarded-For is
# never read.
CLIENT_IP_HEADER=

# Serve the interactive API documentation (/docs, /redoc) and /openapi.json.
# Switch it off in production: the documentation pages load scripts from a
# CDN. backend/openapi.json in the repository documents the API either way.
API_DOCS_ENABLED=true

# Set by the image build (docker build --build-arg REVISION=<commit>) and
# shown by GET / as "revision"; there is no need to set it by hand.
# WEBRISKAUDIT_REVISION=

# Read by the image's start command, not by the API: the port to listen on
# (Cloud Run sets PORT) and how long in-flight requests may run after SIGTERM.
# PORT=8000
# GRACEFUL_SHUTDOWN_SECONDS=8
