# Required command to install dependencies:
# pip install -r requirements.txt

import requests
import dns.resolver
from pydnsbl import DNSBLIpChecker
import socket
import ssl
from datetime import datetime
from colorama import init, Fore, Style
import os

# Initialize colorama
init(autoreset=True)

# Get your API key from https://haveibeenpwned.com/API/Key
# Load from environment variable for security
HIBP_API_KEY = os.getenv("HIBP_API_KEY", "")

class SecurityAuditor:
    """
    A class to perform a passive digital asset security audit for a given domain.
    """

    # WAF Signatures for passive detection
    WAF_SIGNATURES = {
        'cloudflare': ['cf-ray', 'cf-cache-status', 'cf-request-id'],
        'aws_cloudfront': ['x-amz-cf-id', 'x-amz-cf-pop'],
        'sucuri': ['x-sucuri-id', 'x-sucuri-cache'],
        'akamai': ['x-akamai-transformed', 'akamai-origin-hop'],
        'incapsula': ['x-iinfo', 'x-cdn'],
        'barracuda': ['barra_counter_session'],
        'f5_big_ip': ['x-wa-info', 'x-cnection'],
        'fortiweb': ['fortiwafsid'],
        'imperva': ['x-iinfo'],
        'stackpath': ['x-sp-'],
        'fastly': ['x-fastly-request-id', 'fastly-restarts'],
        'varnish': ['x-varnish'],
        'nginx': ['x-nginx-proxy'],
    }

    WAF_SERVER_SIGNATURES = {
        'cloudflare': 'cloudflare',
        'sucuri': 'sucuri',
        'akamai': 'akamaighost',
        'barracuda': 'barracuda',
        'bigip': 'bigip',
        'fortiweb': 'fortiweb',
        'aws_elb': 'awselb',
        'nginx': 'nginx',
        'openresty': 'openresty',
    }

    def __init__(self, domain):
        """
        Initializes the SecurityAuditor.

        :param domain: The domain to audit (e.g., "example.com").
        """
        if domain.startswith(('http://', 'https://')):
            self.domain = domain.split('//')[1]
        else:
            self.domain = domain
        self.report = {}
        self.headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3'}

        # Security Score Tracking
        self.security_score = 0
        self.score_breakdown = {}


    def _print_status(self, check_name, status, is_critical=False, is_warning=False):
        """Helper function to print a formatted status line."""
        status_color = Fore.GREEN
        if is_critical:
            status_color = Fore.RED
        elif is_warning:
            status_color = Fore.YELLOW
        print(f"{check_name:<30} {status_color}{status}{Style.RESET_ALL}")

    def _add_score(self, category, points, description):
        """Helper function to add points to the security score."""
        self.security_score += points
        self.score_breakdown[category] = {"points": points, "description": description}

    def check_waf(self):
        """
        Performs passive WAF detection by analyzing HTTP response headers.
        """
        print("\n--- Web Application Firewall (WAF) Detection ---")
        try:
            response = requests.get(f"https://{self.domain}", headers=self.headers, timeout=10)
            response_headers = {k.lower(): v.lower() for k, v in response.headers.items()}

            detected_waf = None
            detection_method = None

            # Check Server header for WAF signatures
            server_header = response_headers.get('server', '')
            for waf_name, signature in self.WAF_SERVER_SIGNATURES.items():
                if signature in server_header:
                    detected_waf = waf_name.replace('_', ' ').title()
                    detection_method = f"Server header: {server_header}"
                    break

            # Check for WAF-specific headers if not detected via Server header
            if not detected_waf:
                for waf_name, header_list in self.WAF_SIGNATURES.items():
                    for header_signature in header_list:
                        for header_key in response_headers.keys():
                            if header_signature.lower() in header_key.lower():
                                detected_waf = waf_name.replace('_', ' ').title()
                                detection_method = f"Header detected: {header_key}"
                                break
                        if detected_waf:
                            break
                    if detected_waf:
                        break

            # Store results
            if detected_waf:
                self._print_status("WAF Status", f"Present ({detected_waf})")
                self.report['waf'] = {
                    "status": "Detected",
                    "waf_name": detected_waf,
                    "detection_method": detection_method,
                    "risk": "Low"
                }
                # WAF Detected: +20 points
                self._add_score("waf", 20, f"WAF Detected: {detected_waf}")
            else:
                self._print_status("WAF Status", "Not Detected", is_critical=True)
                self.report['waf'] = {
                    "status": "Not Detected",
                    "risk": "High"
                }
                self._add_score("waf", 0, "No WAF Detected")

        except requests.exceptions.RequestException as e:
            self._print_status("WAF Check", f"Error: {e}", is_critical=True)
            self.report['waf'] = {"status": "Error", "error": str(e)}
            self._add_score("waf", 0, "WAF check failed")

    def check_spf(self):
        """
        Checks for the presence and configuration of the SPF record.
        """
        print("\n--- Email Deliverability (SPF) ---")
        try:
            txt_records = dns.resolver.resolve(self.domain, 'TXT')
            spf_record = None
            for record in txt_records:
                if 'v=spf1' in record.to_text():
                    spf_record = record.to_text().strip('"')
                    break

            if not spf_record:
                self._print_status("SPF Record", "Missing", is_critical=True)
                self.report['spf'] = {"status": "Missing", "risk": "High"}
                self._add_score("spf", 0, "SPF Record Missing")
                return

            self._print_status("SPF Record", "Present")
            self.report['spf'] = {"status": "Present", "record": spf_record, "risk": "Low"}

            if "+all" in spf_record:
                self._print_status("SPF Configuration", "Allows all IPs (+all)", is_warning=True)
                self.report['spf']['configuration_risk'] = "Medium"
                # SPF present but misconfigured: +10 points (partial credit)
                self._add_score("spf", 10, "SPF Present but allows all IPs (+all)")
            else:
                self._print_status("SPF Configuration", "Secure")
                # SPF Record Present & Valid: +15 points
                self._add_score("spf", 15, "SPF Record Present & Valid")

        except dns.resolver.NoAnswer:
            self._print_status("SPF Record", "Missing", is_critical=True)
            self.report['spf'] = {"status": "Missing", "risk": "High"}
            self._add_score("spf", 0, "SPF Record Missing")
        except Exception as e:
            self._print_status("SPF Check", f"Error: {e}", is_critical=True)
            self.report['spf'] = {"status": "Error", "error": str(e)}
            self._add_score("spf", 0, "SPF check failed")

    def check_dmarc(self):
        """
        Checks for the presence and policy of the DMARC record.
        """
        print("\n--- Email Deliverability (DMARC) ---")
        try:
            dmarc_domain = f"_dmarc.{self.domain}"
            txt_records = dns.resolver.resolve(dmarc_domain, 'TXT')
            dmarc_record = txt_records[0].to_text().strip('"')

            self._print_status("DMARC Record", "Present")
            self.report['dmarc'] = {"status": "Present", "record": dmarc_record, "risk": "Low"}

            if "p=none" in dmarc_record:
                self._print_status("DMARC Policy", "Policy is 'none'", is_warning=True)
                self.report['dmarc']['policy_risk'] = "Medium"
                # DMARC Present but p=none: +20 points (no bonus)
                self._add_score("dmarc", 20, "DMARC Present (policy: none)")
            elif "p=quarantine" in dmarc_record:
                self._print_status("DMARC Policy", "Secure (quarantine)")
                # DMARC Present with quarantine: +25 points (20 + 5 bonus)
                self._add_score("dmarc", 25, "DMARC Present with quarantine policy (+5 bonus)")
            elif "p=reject" in dmarc_record:
                self._print_status("DMARC Policy", "Secure (reject)")
                # DMARC Present with reject: +25 points (20 + 5 bonus)
                self._add_score("dmarc", 25, "DMARC Present with reject policy (+5 bonus)")
            else:
                # DMARC Present but unknown policy: +20 points
                self._add_score("dmarc", 20, "DMARC Present")

        except dns.resolver.NXDOMAIN:
            self._print_status("DMARC Record", "Missing", is_critical=True)
            self.report['dmarc'] = {"status": "Missing", "risk": "High"}
            self._add_score("dmarc", 0, "DMARC Record Missing")
        except dns.resolver.NoAnswer:
            self._print_status("DMARC Record", "Missing", is_critical=True)
            self.report['dmarc'] = {"status": "Missing", "risk": "High"}
            self._add_score("dmarc", 0, "DMARC Record Missing")
        except Exception as e:
            self._print_status("DMARC Check", f"Error: {e}", is_critical=True)
            self.report['dmarc'] = {"status": "Error", "error": str(e)}
            self._add_score("dmarc", 0, "DMARC check failed")

    def check_web_headers(self):
        """
        Audits critical web security headers.
        """
        print("\n--- Web Security Headers ---")
        try:
            response = requests.get(f"https://{self.domain}", headers=self.headers, timeout=10)
            headers = response.headers

            self.report['web_headers'] = {}
            header_checks = {
                'Strict-Transport-Security': 'HSTS',
                'X-Frame-Options': 'X-Frame-Options',
                'Content-Security-Policy': 'CSP',
                'X-Content-Type-Options': 'X-Content-Type-Options'
            }

            headers_found = 0
            for header, name in header_checks.items():
                if header in headers:
                    self._print_status(name, "Present")
                    self.report['web_headers'][name] = {"status": "Present", "risk": "Low"}
                    headers_found += 1
                else:
                    self._print_status(name, "Missing", is_critical=True)
                    self.report['web_headers'][name] = {"status": "Missing", "risk": "High"}

            # Security Headers: +5 points for EACH header found. Max 20 points.
            header_points = min(headers_found * 5, 20)
            self._add_score("security_headers", header_points, f"{headers_found}/4 Security Headers Present")

        except requests.exceptions.RequestException as e:
            self._print_status("Web Headers Check", f"Error: {e}", is_critical=True)
            self.report['web_headers'] = {"status": "Error", "error": str(e)}
            self._add_score("security_headers", 0, "Security headers check failed")

    def check_ssl_cert(self):
        """
        Checks the SSL/TLS certificate's expiry date.
        """
        print("\n--- SSL/TLS Certificate Health ---")
        try:
            context = ssl.create_default_context()
            with socket.create_connection((self.domain, 443)) as sock:
                with context.wrap_socket(sock, server_hostname=self.domain) as ssock:
                    cert = ssock.getpeercert()
                    expiry_date = datetime.strptime(cert['notAfter'], '%b %d %H:%M:%S %Y %Z')
                    days_remaining = (expiry_date - datetime.now()).days

                    self.report['ssl_cert'] = {
                        "expiry_date": expiry_date.strftime('%Y-%m-%d'),
                        "days_remaining": days_remaining
                    }

                    if days_remaining <= 0:
                        self._print_status("Certificate Status", f"Expired ({days_remaining} days ago)", is_critical=True)
                        self.report['ssl_cert']['risk'] = "High"
                        # SSL/TLS Invalid (Expired): 0 points
                        self._add_score("ssl", 0, "SSL Certificate Expired")
                    elif days_remaining < 30:
                        self._print_status("Certificate Status", f"Expires soon ({days_remaining} days left)", is_warning=True)
                        self.report['ssl_cert']['risk'] = "Medium"
                        # SSL/TLS Valid but expiring soon: +5 points (partial)
                        self._add_score("ssl", 5, f"SSL Valid but expires in {days_remaining} days")
                    else:
                        self._print_status("Certificate Status", f"Valid ({days_remaining} days left)")
                        self.report['ssl_cert']['risk'] = "Low"
                        # SSL/TLS Valid: +10 points
                        self._add_score("ssl", 10, f"SSL Certificate Valid ({days_remaining} days remaining)")

        except Exception as e:
            self._print_status("SSL/TLS Check", f"Error: {e}", is_critical=True)
            self.report['ssl_cert'] = {"status": "Error", "error": str(e)}
            self._add_score("ssl", 0, "SSL check failed")

    def check_ip_reputation(self):
        """
        Checks the domain's IP address against DNS blacklists.
        """
        print("\n--- IP Reputation (Blacklist Check) ---")
        try:
            ip_address = socket.gethostbyname(self.domain)
            self._print_status("Domain IP", ip_address)
            self.report['ip_reputation'] = {"ip_address": ip_address}

            checker = DNSBLIpChecker()
            result = checker.check(ip_address)

            if result.blacklisted:
                self._print_status("Blacklist Status", f"Listed on: {result.categories}", is_critical=True)
                self.report['ip_reputation']['status'] = "Blacklisted"
                self.report['ip_reputation']['details'] = result.details
                self.report['ip_reputation']['risk'] = "High"
                # Blacklisted: 0 points
                self._add_score("blacklist", 0, "IP is Blacklisted")
            else:
                self._print_status("Blacklist Status", "Not blacklisted")
                self.report['ip_reputation']['status'] = "Clean"
                self.report['ip_reputation']['risk'] = "Low"
                # No Blacklist: +10 points
                self._add_score("blacklist", 10, "IP is Clean (Not Blacklisted)")

        except socket.gaierror:
            self._print_status("IP Reputation Check", "Domain could not be resolved", is_critical=True)
            self.report['ip_reputation'] = {"status": "Error", "error": "Domain not resolved"}
            self._add_score("blacklist", 0, "IP reputation check failed")
        except Exception as e:
            self._print_status("IP Reputation Check", f"Error: {e}", is_critical=True)
            self.report['ip_reputation'] = {"status": "Error", "error": str(e)}
            self._add_score("blacklist", 0, "IP reputation check failed")

    def check_info_disclosure(self):
        """
        Analyzes HTTP headers for information disclosure.
        """
        print("\n--- Information Disclosure (Tech Leak) ---")
        try:
            response = requests.get(f"https://{self.domain}", headers=self.headers, timeout=10)
            headers = response.headers

            self.report['info_disclosure'] = {}
            tech_headers = ['Server', 'X-Powered-By', 'X-Generator']
            found_leak = False

            for header in tech_headers:
                if header in headers:
                    value = headers[header]
                    self._print_status(f"Header '{header}'", f"Found: {value}", is_warning=True)
                    self.report['info_disclosure'][header] = value
                    found_leak = True

            if not found_leak:
                self._print_status("Tech Headers", "No revealing headers found")
                self.report['info_disclosure']['status'] = "Clean"
            else:
                self.report['info_disclosure']['risk'] = "Medium"

        except requests.exceptions.RequestException as e:
            self._print_status("Info Disclosure Check", f"Error: {e}", is_critical=True)
            self.report['info_disclosure'] = {"status": "Error", "error": str(e)}


    def check_gdpr_compliance(self):
        """
        Performs a basic check for GDPR/privacy policy links on the homepage.
        """
        print("\n--- Basic Compliance (GDPR/RODO) ---")
        try:
            response = requests.get(f"https://{self.domain}", headers=self.headers, timeout=10)
            content = response.text.lower()
            keywords = ["privacy policy", "cookie", "rodo", "gdpr"]

            found_keyword = any(keyword in content for keyword in keywords)

            if found_keyword:
                self._print_status("Privacy Indicators", "Detected")
                self.report['compliance'] = {"status": "Detected", "risk": "Low"}
            else:
                self._print_status("Privacy Indicators", "Not detected", is_warning=True)
                self.report['compliance'] = {"status": "Not Detected", "risk": "Medium"}

        except requests.exceptions.RequestException as e:
            self._print_status("Compliance Check", f"Error: {e}", is_critical=True)
            self.report['compliance'] = {"status": "Error", "error": str(e)}

    def check_typosquatting(self):
        """
        Generates and checks for common typosquatting domain variations.
        """
        print("\n--- BRAND & PERSONNEL RISKS (Typosquatting) ---")
        self.report['typosquatting'] = {"potential_threats": []}
        base_domain, tld = self.domain.rsplit('.', 1)
        variations = set([
            # Character omission
            base_domain[:-1] + '.' + tld,
            # Character doubling
            base_domain + base_domain[-1] + '.' + tld,
            # Character swap
            base_domain.replace('o', '0') + '.' + tld,
            base_domain.replace('l', '1') + '.' + tld,
            base_domain.replace('i', '1') + '.' + tld,
            # Added dot
            base_domain.replace('.', '') + '.' + tld,
            # Missing dot
            base_domain.replace('.', '') + tld,
        ])

        found_threat = False
        for variation in sorted(list(variations)):
            if variation == self.domain:
                continue
            try:
                dns.resolver.resolve(variation, 'A')
                self._print_status(f"Typosquatting variation", f"{variation} - POTENTIAL THREAT", is_critical=True)
                self.report['typosquatting']['potential_threats'].append(variation)
                found_threat = True
            except (dns.resolver.NXDOMAIN, dns.resolver.NoAnswer):
                pass
            except Exception: # Other DNS errors
                pass

        if not found_threat:
            self._print_status("Typosquatting Scan", "No immediate threats found")

    def check_hibp(self):
        """
        Checks common email addresses for breaches using HaveIBeenPwned API.
        """
        print("\n--- BRAND & PERSONNEL RISKS (Data Leaks) ---")
        if not HIBP_API_KEY:
            self._print_status("HIBP Check", "[INFO] HIBP API Key missing. Skipping leak check.", is_warning=True)
            return

        self.report['hibp'] = {}
        generic_accounts = [f"info@{self.domain}", f"admin@{self.domain}", f"contact@{self.domain}"]
        headers = {'hibp-api-key': HIBP_API_KEY, 'user-agent': 'Gemini-Security-Auditor'}

        found_breach = False
        for account in generic_accounts:
            try:
                response = requests.get(f"https://haveibeenpwned.com/api/v3/breachedaccount/{account}", headers=headers, timeout=10)
                if response.status_code == 200:
                    breaches = response.json()
                    breach_names = [b['Name'] for b in breaches]
                    self._print_status(f"HIBP Check for {account}", f"Found in breaches: {', '.join(breach_names)}", is_critical=True)
                    self.report['hibp'][account] = breach_names
                    found_breach = True
                elif response.status_code == 404:
                    self._print_status(f"HIBP Check for {account}", "No breaches found")
            except requests.exceptions.RequestException as e:
                self._print_status("HIBP Check", f"Error: {e}", is_critical=True)
                self.report['hibp'] = {"status": "Error", "error": str(e)}

        if not found_breach:
            self._print_status("Data Leak Scan", "No breaches found for generic accounts")

    def _print_audit_summary(self):
        """
        Prints a visual audit summary box with the final security score.
        """
        # Determine risk level and color based on score
        if self.security_score >= 80:
            risk_level = "SECURE"
            score_color = Fore.GREEN
            risk_color = Fore.GREEN
        elif self.security_score >= 50:
            risk_level = "MODERATE RISK"
            score_color = Fore.YELLOW
            risk_color = Fore.YELLOW
        else:
            risk_level = "CRITICAL RISK"
            score_color = Fore.RED
            risk_color = Fore.RED

        # Build the summary box
        box_width = 60
        border = "=" * box_width

        print(f"\n{Style.BRIGHT}{Fore.CYAN}{border}{Style.RESET_ALL}")
        print(f"{Style.BRIGHT}{Fore.CYAN}{'AUDIT SUMMARY':^{box_width}}{Style.RESET_ALL}")
        print(f"{Style.BRIGHT}{Fore.CYAN}{border}{Style.RESET_ALL}")

        # Score breakdown header
        print(f"\n{Style.BRIGHT}Score Breakdown:{Style.RESET_ALL}")
        print("-" * 50)

        # Print each scoring category
        score_order = ['ssl', 'spf', 'dmarc', 'waf', 'security_headers', 'blacklist']
        category_names = {
            'ssl': 'SSL/TLS Certificate',
            'spf': 'SPF Record',
            'dmarc': 'DMARC Record',
            'waf': 'WAF Protection',
            'security_headers': 'Security Headers',
            'blacklist': 'Blacklist Status'
        }
        max_points = {
            'ssl': 10,
            'spf': 15,
            'dmarc': 25,
            'waf': 20,
            'security_headers': 20,
            'blacklist': 10
        }

        for category in score_order:
            if category in self.score_breakdown:
                points = self.score_breakdown[category]['points']
                max_pts = max_points[category]
                name = category_names[category]

                # Color code based on percentage of max points achieved
                if points == max_pts:
                    pts_color = Fore.GREEN
                elif points > 0:
                    pts_color = Fore.YELLOW
                else:
                    pts_color = Fore.RED

                print(f"  {name:<25} {pts_color}{points:>3}/{max_pts:<3}{Style.RESET_ALL} pts")

        print("-" * 50)

        # Final Score Display
        print(f"\n{Style.BRIGHT}{'SECURITY SCORE:':<20}{score_color}{self.security_score}/100{Style.RESET_ALL}")
        print(f"{Style.BRIGHT}{'RISK ASSESSMENT:':<20}{risk_color}{risk_level}{Style.RESET_ALL}")

        # Visual score bar
        filled = int((self.security_score / 100) * 40)
        empty = 40 - filled
        score_bar = f"[{score_color}{'█' * filled}{Style.RESET_ALL}{'░' * empty}]"
        print(f"\n{score_bar} {score_color}{self.security_score}%{Style.RESET_ALL}")

        print(f"\n{Style.BRIGHT}{Fore.CYAN}{border}{Style.RESET_ALL}")

        # Add recommendations based on missing points
        if self.security_score < 100:
            print(f"\n{Style.BRIGHT}Recommendations:{Style.RESET_ALL}")
            for category in score_order:
                if category in self.score_breakdown:
                    points = self.score_breakdown[category]['points']
                    max_pts = max_points[category]
                    if points < max_pts:
                        missing = max_pts - points
                        print(f"  {Fore.YELLOW}[+{missing} pts]{Style.RESET_ALL} Improve {category_names[category]}")


    def run_audit(self, return_json=False):
        """
        Runs all the security audit checks.

        :param return_json: If True, returns the report as a JSON object.
        """
        print(f"{Style.BRIGHT}\nStarting passive security audit for: {self.domain}\n{Style.RESET_ALL}")

        # Reset score for fresh audit
        self.security_score = 0
        self.score_breakdown = {}

        # Run all checks (WAF added first for logical flow)
        self.check_ssl_cert()
        self.check_spf()
        self.check_dmarc()
        self.check_waf()
        self.check_web_headers()
        self.check_ip_reputation()
        self.check_info_disclosure()
        self.check_gdpr_compliance()
        self.check_typosquatting()
        self.check_hibp()

        # Print the audit summary with security score
        self._print_audit_summary()

        print(f"{Style.BRIGHT}\nAudit Complete.\n{Style.RESET_ALL}")

        if return_json:
            import json
            # Add score to report
            self.report['security_score'] = {
                "total": self.security_score,
                "max_possible": 100,
                "breakdown": self.score_breakdown
            }
            return json.dumps(self.report, indent=4)


if __name__ == '__main__':
    # Example usage:
    # Replace "example.com" with the domain you want to audit.
    # You can also use a command-line argument to pass the domain.
    import sys

    domain_to_audit = "google.com" # Default domain
    if len(sys.argv) > 1:
        domain_to_audit = sys.argv[1]

    auditor = SecurityAuditor(domain_to_audit)
    json_report = auditor.run_audit(return_json=True)

    # You can now use the json_report variable if you need it.
    # For example, to save it to a file:
    # with open('security_report.json', 'w') as f:
    #     f.write(json_report)
