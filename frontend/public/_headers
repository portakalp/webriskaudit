# Response headers for the site on Cloudflare Workers static assets
# (wrangler.jsonc), which read this file from the assets directory
# (out/_headers after pnpm build) and do not serve it:
# https://developers.cloudflare.com/workers/static-assets/headers/
# nginx.conf sends the same security headers in the Docker image; keep the
# two files in sync.
#
# script-src needs 'unsafe-inline' because the Next.js static export inlines
# its bootstrap scripts and static hosting cannot add a per-request nonce.
# A hash-based policy is future work.
#
# connect-src must allow NEXT_PUBLIC_API_URL, the repository variable the
# deploy workflow builds with (https://api.webriskaudit.com); change the two
# together, or the browser blocks every scan. The deploy job refuses a build
# where they differ.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.webriskaudit.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Build assets have content-hashed names and never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
