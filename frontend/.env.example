# Base URL of the WebRiskAudit API, without a trailing slash. It is inlined
# into the static build, so set it before running "pnpm build".
# If it is unset, "pnpm dev" falls back to http://localhost:8000 and a
# production build treats the API as unavailable and offers the sample report.
NEXT_PUBLIC_API_URL=http://localhost:8000
